;; The events of a form, and `web.get`/`web.set` on properties, classes
;; and styles. The last click sets an element that does not exist: the
;; program ends with an error.

web.set("num", "text", 10)
web.set("num", "text", web.get("num", "text") ++ "/" ++ tostring(web.get("box", "checked")))

spawn {
    loop e on :input [id="name"] {
        web.set("echo", "text", e.value)
    }
}
spawn {
    loop e on :change [id="box"] {
        web.set("echo", "class.on", e.value)
        web.set("state", "text", web.get("box", "checked") && "checked" || "unchecked")
    }
}
spawn {
    loop e on :key.dn {
        web.set("key", "text", e.key ++ "/" ++ e.code)
    }
}
spawn {
    loop on :click [id="hide"] {
        web.set("echo", "hidden", true)
    }
}
spawn {
    loop on :click [id="color"] {    ;; the click is on the span inside
        web.set("echo", "style.color", "rgb(255, 0, 0)")
        web.set("color2", "text", web.get("echo", "style.color"))
    }
}

await :click [id="bad"]
web.set("nope", "text", "x")
