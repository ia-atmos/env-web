;; The IDE: an editor, a mode (web or pico), and a button that sends the
;; program to the server of the IDE (serve.py), which compiles it and
;; answers with the address of its page, shown beside the editor.
;;
;; With a guide (the page /guide/<name>), it also shows the steps of the
;; guide: the text of a step, with its exercises, and its program in the
;; editor.
;;
;; In the static site (site/build.py) each step comes with its page
;; already compiled, and Run shows it while the program is as the guide
;; gives it. An edited program goes to the compile server, at the address
;; that the page gives (`run` with serve.py, `run.cgi` on the site).

val guide  = web.get("guide",  "content")
val static = web.get("static", "content") == "1"
val server = web.get("server", "content")

func sample () {
    web.set("code", "value", web.get("sample-" ++ web.get("mode", "value"), "value"))
}

task Samples () {
    sample()
    loop on :change [id="mode"] {
        sample()
    }
}

task Guide () {
    val info = await web.fetch("g/" ++ guide ++ "/info")
    val l1 = string.find(info.text, "\n")
    val l2 = string.find(info.text, "\n", l1+1)
    val n  = tonumber(string.sub(info.text, l2+1))
    web.set("guides", "value", guide)
    web.set("mode",   "value", string.sub(info.text, l1+1, l2-1))
    web.set("mode",   "disabled", true)     ;; the mode is that of the guide
    loop i in (1,n) {
        web.new(:option, [parent="step", value=tostring(i), text="step " ++ tostring(i)])
    }
    web.set("body", "class.guide", true)

    var i = 1
    loop {
        val url = "g/" ++ guide ++ "/" ++ tostring(i)
        web.set("step", "value", tostring(i))
        web.set("text", "innerHTML", (await web.fetch(url ++ "/text")).text)
        val code = (await web.fetch(url ++ "/code")).text
        web.set("code", "value", code)
        if static {
            web.set("code", "attr.data-orig", code)
            web.set("code", "attr.data-page", url ++ "/main.html")
        }
        web.set("text", "scrollTop", 0)
        web.set("text", "attr.data-step", tostring(i))    ;; the step shown

        val e = await <:change [id="step"] || :click [id="prev"] || :click [id="next"] || :click [id="reset"]>
        match e.id {
            "prev" => { set i = math.max(1, i-1) }
            "next" => { set i = math.min(n, i+1) }
            "step" => { set i = tonumber(e.value) }
        }
    }
}

pin side = if guide == "" {
    spawn Samples()
} else {
    spawn Guide()
}

await :click [id="run"]
loop {
    ;; another click starts over: a request in course is cancelled
    watching :click [id="run"] {
        val code = web.get("code", "value")
        if static && (code == web.get("code", "attr.data-orig")) {
            ;; as the guide gives it: its page is already compiled
            web.set("log", "class.error", false)
            web.set("log", "text", "")
            web.set("runner", "src", web.get("code", "attr.data-page"))
        } else {
            web.set("status", "text", "compiling...")
            val url = server ++ "?mode=" ++ web.get("mode", "value") ++ "&guide=" ++ guide
            val r = await web.fetch(url, [method="POST", body=code])
            web.set("status", "text", "")
            web.set("log", "class.error", !r.ok)
            if r.ok {
                web.set("log", "text", "")
                web.set("runner", "src", r.text)
            } else {
                web.set("log", "text", if r.status == 400 => r.text => "The compile server did not answer (status " ++ r.status ++ ").")
            }
        }
        await false
    }
}
