+static void aux (SDL_Rect* a, SDL_Rect* b, int max_w, int max_h) {
+    assert(a->w>0 && a->h>0);
+    float sw = b->w / (float)a->w;
+    float sh = b->h / (float)a->h;
+    if (a->x < 0) {
+        int d = -a->x;
+        b->x += (d * sw);
+        b->w -= (d * sw);
+        a->w -= d;
+        a->x = 0;
+    }
+    if (a->y < 0) {
+        int d = -a->y;
+        b->y += (d * sh);
+        b->h -= (d * sh);
+        a->h -= d;
+        a->y = 0;
+    }
+    if (a->x+a->w > max_w) {
+        int d = (a->x + a->w) - max_w;
+        b->w -= (d * sw);
+        a->w -= d;
+    }
+    if (a->y+a->h > max_h) {
+        int d = (a->y + a->h) - max_h;
+        b->h -= (d * sh);
+        a->h -= d;
+    }
+}
