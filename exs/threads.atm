;; A tree of threads, as in the old plan of the DOM: the program creates
;; the page. A new thread each second, a reply to the last one each
;; 200ms, and a counter of the threads that are open. Each thread has a
;; button that removes it.

web.new(:p,   [id="open", text="open: 0"])
web.new(:div, [id="tree"])

val senders = ["alice", "bob", "chico", "diana"]

task Thread (n) {
    val id = "t" ++ tostring(n)
    val x  = id ++ "-x"
    web.new(:details, [id=id, parent="tree", open=true,
        web.new(:summary, [text = senders@(n % #senders) ++ ": thread " ++ tostring(n)]),
        web.new(:button,  [id=x, text="remove"]),
    ])
    defer {
        web.del(id)
    }
    watching :click [id=x] {
        var r = 0
        loop {
            await 200ms
            set r += 1
            web.new(:div, [parent=id, text="reply " ++ tostring(r)])
        }
    }
}

spawn {     ;; how many are open
    var n = 0
    loop e on :toggle {
        set n += (e.open && 1 || -1)
        web.set("open", "text", "open: " ++ tostring(n))
    }
}

pin threads = tasks()
var n = 0
loop {
    set n += 1
    spawn @threads Thread(n)
    await 1s
}
