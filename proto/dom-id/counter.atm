;; The counter with the ids of the HTML directly, filtered by patterns.

web.text("msg", "running")
web.on("inc",  "click")
web.on("stop", "click")

watching :click [id="stop"] {
    spawn {
        var s = 0
        loop {
            await 1s
            set s += 1
            web.text("secs", tostring(s))
        }
    }
    var n = 0
    loop on :click [id="inc"] {
        set n += 1
        web.text("count", tostring(n))
    }
}

web.text("msg", "stopped")
print("stopped")
