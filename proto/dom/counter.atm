;; A counter on the DOM: a button that counts, a clock of seconds, and a
;; button that ends both (the style of env-iup's button-counter).

pin msg   = web.get("msg")
pin count = web.get("count")
pin secs  = web.get("secs")
pin inc   = web.get("inc")
pin stop  = web.get("stop")

web.text(msg, "running")

watching :click [h=stop] {
    spawn {
        var s = 0
        loop {
            await 1s
            set s += 1
            web.text(secs, tostring(s))
        }
    }
    var n = 0
    loop on :click [h=inc] {
        set n += 1
        web.text(count, tostring(n))
    }
}

web.text(msg, "stopped")
print("stopped")
