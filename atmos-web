#!/bin/sh
# Builds a page from an Atmos program, with `web.atm` included:
#
#   atmos-web <prog.atm> [<outdir>]
#
# The result is <outdir>/<prog>.html (with its .js and .wasm), to be
# served over HTTP. <outdir> is `out` by default. If <prog>.html exists
# beside the program, it is the page (it must have the line
# `{{{ SCRIPT }}}` where the program is loaded); otherwise the page is
# empty, and the program creates its elements.
#
# It needs `emcc` (Emscripten) in the PATH and a built checkout of
# https://github.com/ia-atmos/lang in ATMOS (`../lang` by default).
set -e
HERE=$(cd "$(dirname "$0")" && pwd)
ATMOS=${ATMOS:-$HERE/../lang}
[ -n "$1" ] || { echo "usage: atmos-web <prog.atm> [<outdir>]" >&2; exit 1; }
[ -x "$ATMOS/atmos" ] || { echo "atmos-web : compiler not found : $ATMOS/atmos (set ATMOS=/path/to/lang)" >&2; exit 1; }
command -v emcc >/dev/null || { echo "atmos-web : emcc not found (Emscripten)" >&2; exit 1; }
SRC=$1
OUT=${2:-out}
NAME=$(basename "$SRC" .atm)
PAGE=$(dirname "$SRC")/$NAME.html
[ -f "$PAGE" ] || PAGE=$HERE/page.html
mkdir -p "$OUT"
"$ATMOS/atmos" -c -e "$HERE/web.atm" "$SRC" > "$OUT/$NAME.c"
RT=$(ls "$ATMOS"/rt/*.c | grep -v '/main\.c$')
emcc ${ATMOS_CFLAGS:--O2} -I"$ATMOS/rt" "$OUT/$NAME.c" $RT "$ATMOS/rt/main.c" \
    -sALLOW_MEMORY_GROWTH -sEXPORTED_FUNCTIONS=_main,_malloc,_free --shell-file "$PAGE" -o "$OUT/$NAME.html"
